{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "middle-school-english/assessment.schema.json",
  "title": "Middle School English Generated Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["assessment_id", "request", "blueprint", "items"],
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 1
    },
    "request": {"$ref": "#/$defs/assessmentRequest"},
    "blueprint": {"$ref": "#/$defs/blueprint"},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/assessmentItem"}
    }
  },
  "$defs": {
    "unitId": {
      "type": "string",
      "pattern": "^(starter|unit)-[0-9]{2}$"
    },
    "itemType": {
      "type": "string",
      "enum": [
        "listening_blueprint",
        "single_choice",
        "cloze",
        "reading_multiple_choice",
        "reading_matching",
        "task_based_reading",
        "vocabulary_in_context",
        "grammar_fill",
        "sentence_completion",
        "word_bank_fill",
        "practical_writing"
      ]
    },
    "assessmentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["book_id", "purpose", "item_type_plan", "outputs"],
      "properties": {
        "book_id": {"type": "string", "pattern": "^grade-0[789]-semester-[12]$"},
        "unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/unitId"}
        },
        "assessment_scope": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "duration_minutes": {"type": "integer", "minimum": 1},
        "total_score": {"type": "number", "exclusiveMinimum": 0},
        "difficulty_target": {
          "type": "string",
          "enum": ["easy", "medium", "hard", "mixed"]
        },
        "reinforcement": {"type": "boolean", "default": false},
        "item_type_plan": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/itemTypePlanLine"}
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["student", "teacher", "answer_sheet"]
          }
        }
      },
      "oneOf": [
        {"required": ["unit_ids"]},
        {"required": ["assessment_scope"]}
      ]
    },
    "itemTypePlanLine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_type", "item_count", "score_each"],
      "properties": {
        "item_type": {"$ref": "#/$defs/itemType"},
        "item_count": {"type": "integer", "minimum": 1},
        "score_each": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blueprint_id", "request", "sections", "coverage_targets", "score_check"],
      "properties": {
        "blueprint_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1
        },
        "request": {"$ref": "#/$defs/assessmentRequest"},
        "catalog_status": {"type": "string", "enum": ["released", "candidate"]},
        "resolved_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/unitId"}
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/blueprintSection"}
        },
        "coverage_targets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/coverageTarget"}
        },
        "score_check": {"$ref": "#/$defs/scoreCheck"},
        "boundary_check": {"$ref": "#/$defs/boundaryCheck"}
      }
    },
    "blueprintSection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_type", "item_count", "score_each", "score_total"],
      "properties": {
        "section_id": {"type": "string", "minLength": 1},
        "item_type": {"$ref": "#/$defs/itemType"},
        "item_count": {"type": "integer", "minimum": 1},
        "score_each": {"type": "number", "exclusiveMinimum": 0},
        "score_total": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "coverageTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_item_id", "target_role", "planned_item_count"],
      "properties": {
        "canonical_item_id": {"type": "string", "minLength": 1},
        "target_role": {"type": "string", "enum": ["primary", "context"]},
        "planned_item_count": {"type": "integer", "minimum": 1}
      }
    },
    "scoreCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_total", "computed_total"],
      "properties": {
        "expected_total": {"type": "number", "exclusiveMinimum": 0},
        "computed_total": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "boundaryCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_primary_levels", "reinforcement", "context_only_level"],
      "properties": {
        "allowed_primary_levels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["A", "B"]}
        },
        "reinforcement": {"type": "boolean"},
        "context_only_level": {"type": "string", "const": "D"}
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_id", "text"],
      "properties": {
        "option_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "optionArray": {
      "type": "array",
      "minItems": 2,
      "maxItems": 6,
      "items": {"$ref": "#/$defs/option"}
    },
    "singleChoiceAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["option_ids"],
      "properties": {
        "option_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}
        }
      }
    },
    "blank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blank_id", "position"],
      "properties": {
        "blank_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "position": {"type": "integer", "minimum": 1},
        "target": {"type": "string", "minLength": 1}
      }
    },
    "clozeOptionSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blank_id", "options"],
      "properties": {
        "blank_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "options": {"$ref": "#/$defs/optionArray"}
      }
    },
    "clozeOptions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/clozeOptionSet"}
    },
    "blankAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blank_id", "value"],
      "properties": {
        "blank_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "value": {"type": "string", "minLength": 1},
        "option_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}
      }
    },
    "clozeAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blank_answers"],
      "properties": {
        "blank_answers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/blankAnswer"}
        }
      }
    },
    "matchingPrompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "text"],
      "properties": {
        "prompt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "matchingPrompts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/matchingPrompt"}
    },
    "matchingOptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {"$ref": "#/$defs/option"}
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "option_id"],
      "properties": {
        "prompt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "option_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_-]*$"}
      }
    },
    "matchingAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matches"],
      "properties": {
        "matches": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/match"}
        }
      }
    },
    "speakerRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "purpose"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "speakerRoles": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/speakerRole"}
    },
    "taskStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "task_kind", "item_count", "score"],
      "properties": {
        "step": {"type": "integer", "minimum": 1},
        "task_kind": {"type": "string", "minLength": 1},
        "item_count": {"type": "integer", "minimum": 1},
        "score": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "taskSequence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/taskStep"}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "prompt", "response_format", "score"],
      "properties": {
        "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
        "prompt": {"type": "string", "minLength": 1},
        "response_format": {"type": "string", "minLength": 1},
        "score": {"type": "number", "exclusiveMinimum": 0},
        "evidence_requirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/task"}
    },
    "structuredResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["responses"],
      "properties": {
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["task_id", "response"],
            "properties": {
              "task_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"},
              "response": {}
            }
          }
        }
      }
    },
    "oneOptionOrWordAnswer": {
      "oneOf": [
        {"$ref": "#/$defs/singleChoiceAnswer"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["value"],
          "properties": {"value": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "freeResponseAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "accepted"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "accepted": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "constraints": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "wordBank": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "wordBankAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blank_answers"],
      "properties": {
        "blank_answers": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/blankAnswer"}
        }
      }
    },
    "rubricCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion", "points", "descriptor"],
      "properties": {
        "criterion": {"type": "string", "minLength": 1},
        "points": {"type": "number", "exclusiveMinimum": 0},
        "descriptor": {"type": "string", "minLength": 1}
      }
    },
    "rubric": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rubricCriterion"}
    },
    "practicalWritingAnswer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["response"],
      "properties": {
        "response": {"type": "string", "minLength": 1},
        "accepted_elements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "stimulusAssets": {
      "type": "array",
      "description": "Optional print asset references (PRD FR-16). An asset_id is the only resource reference; file paths, DPI and rights live in the bound asset manifest, never here. This optional extension does not change any existing answer, score, canonical-evidence or item-type contract.",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/stimulusAsset"}
    },
    "stimulusAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "semantic_role", "placement"],
      "properties": {
        "asset_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "semantic_role": {
          "type": "string",
          "enum": ["stimulus", "required_context", "decorative"]
        },
        "placement": {
          "type": "string",
          "enum": ["before_passage", "after_passage", "before_stem", "after_stem", "inline_block"]
        },
        "after_block_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Required when placement is inline_block: the semantic anchor block within the owning item that this asset follows."
        },
        "required_for_answer": {"type": "boolean"},
        "caption": {
          "type": "string",
          "description": "Optional short caption; must not contain the answer."
        }
      },
      "allOf": [
        {
          "if": {"properties": {"placement": {"const": "inline_block"}}},
          "then": {"required": ["after_block_id"]}
        }
      ]
    },
    "assessmentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "item_type", "score", "canonical_item_ids"],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "minLength": 1
        },
        "item_type": {"$ref": "#/$defs/itemType"},
        "stem": {"type": "string", "minLength": 1},
        "passage": {"type": "string", "minLength": 1},
        "prompt": {"type": "string", "minLength": 1},
        "context": {"type": "string", "minLength": 1},
        "script_outline": {"type": "string", "minLength": 1},
        "speaker_roles": {"$ref": "#/$defs/speakerRoles"},
        "task_sequence": {"$ref": "#/$defs/taskSequence"},
        "target_skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "options": {"type": "array"},
        "blanks": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/blank"}
        },
        "prompts": {"type": "array"},
        "tasks": {"$ref": "#/$defs/tasks"},
        "word_bank": {"$ref": "#/$defs/wordBank"},
        "rubric": {"$ref": "#/$defs/rubric"},
        "answer": {},
        "rationale": {"type": "string", "minLength": 1},
        "score": {"type": "number", "exclusiveMinimum": 0},
        "difficulty": {"type": "string", "enum": ["easy", "medium", "hard"]},
        "canonical_item_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "context_item_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}
        },
        "stimulus_assets": {"$ref": "#/$defs/stimulusAssets"},
        "validation": {"type": "object", "additionalProperties": true}
      },
      "allOf": [
        {
          "if": {"properties": {"item_type": {"const": "listening_blueprint"}}},
          "then": {
            "required": ["script_outline", "speaker_roles", "task_sequence", "target_skills"],
            "not": {"anyOf": [{"required": ["answer"]}, {"required": ["rationale"]}]}
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "single_choice"}}},
          "then": {
            "required": ["stem", "options", "answer", "rationale"],
            "properties": {
              "options": {"$ref": "#/$defs/optionArray"},
              "answer": {"$ref": "#/$defs/singleChoiceAnswer"}
            }
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "cloze"}}},
          "then": {
            "required": ["passage", "blanks", "options", "answer", "rationale"],
            "properties": {
              "options": {"$ref": "#/$defs/clozeOptions"},
              "answer": {"$ref": "#/$defs/clozeAnswer"}
            }
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "reading_multiple_choice"}}},
          "then": {
            "required": ["passage", "stem", "options", "answer", "rationale"],
            "properties": {
              "options": {"$ref": "#/$defs/optionArray"},
              "answer": {"$ref": "#/$defs/singleChoiceAnswer"}
            }
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "reading_matching"}}},
          "then": {
            "required": ["passage", "prompts", "options", "answer", "rationale"],
            "properties": {
              "prompts": {"$ref": "#/$defs/matchingPrompts"},
              "options": {"$ref": "#/$defs/matchingOptions"},
              "answer": {"$ref": "#/$defs/matchingAnswer"}
            }
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "task_based_reading"}}},
          "then": {
            "required": ["passage", "tasks", "answer", "rationale"],
            "properties": {"answer": {"$ref": "#/$defs/structuredResponse"}}
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "vocabulary_in_context"}}},
          "then": {
            "required": ["context", "stem", "options", "answer", "rationale"],
            "properties": {
              "options": {"$ref": "#/$defs/optionArray"},
              "answer": {"$ref": "#/$defs/oneOptionOrWordAnswer"}
            }
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "grammar_fill"}}},
          "then": {
            "required": ["stem", "answer", "rationale"],
            "properties": {"answer": {"$ref": "#/$defs/freeResponseAnswer"}}
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "sentence_completion"}}},
          "then": {
            "required": ["stem", "answer", "rationale"],
            "properties": {"answer": {"$ref": "#/$defs/freeResponseAnswer"}}
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "word_bank_fill"}}},
          "then": {
            "required": ["stem", "blanks", "word_bank", "answer", "rationale"],
            "properties": {"answer": {"$ref": "#/$defs/wordBankAnswer"}}
          }
        },
        {
          "if": {"properties": {"item_type": {"const": "practical_writing"}}},
          "then": {
            "required": ["prompt", "rubric", "answer", "rationale"],
            "properties": {"answer": {"$ref": "#/$defs/practicalWritingAnswer"}}
          }
        }
      ]
    }
  }
}
